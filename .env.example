# ==============================================================================
# BHIV Central Payment Service Configuration
# ==============================================================================

# Application Environment: 'development', 'staging', 'production'
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL for Docker/Production, SQLite supported for local dev/testing)
# PostgreSQL example: postgresql+psycopg2://postgres:postgres@localhost:5432/bhiv_payments
# SQLite example: sqlite:///./payments.db
DATABASE_URL=sqlite:///./payments.db

# Payment Provider Configuration: 'razorpay'
PAYMENT_PROVIDER=razorpay

# Razorpay Test / Live Credentials
# For test mode, keys start with 'rzp_test_'
# For live mode, keys start with 'rzp_live_' (mandatory in production)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Master Admin Key for administrative endpoints (/api/v1/admin/*)
ADMIN_API_KEY=bhiv_admin_super_secret_key_change_in_production

# Logging Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
